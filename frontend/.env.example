# Backend connection — set this to the HTTPS FastAPI URL for each deployment.
# Never use localhost in the production Android build.
NEXT_PUBLIC_API_URL=https://api.your-vegito-domain.example/api/v1

# Optional local Android device override for a FastAPI server on the same LAN.
# Leave unset for production Android builds so HTTPS NEXT_PUBLIC_API_URL is used.
# NEXT_PUBLIC_ANDROID_API_URL=http://192.168.1.100:8000/api/v1
# Set to true only in a local debug build; it logs request URLs and statuses,
# never request bodies, OTPs, tokens, or response bodies.
NEXT_PUBLIC_API_DEBUG=false

# Capacitor loads the deployed Next.js web application in Android. This must
# be its HTTPS URL (not the FastAPI API URL) for staging/production builds.
CAPACITOR_SERVER_URL=https://app.your-vegito-domain.example

# App info
NEXT_PUBLIC_APP_NAME=Vegito
NEXT_PUBLIC_APP_TAGLINE=Fresh vegetables. Simple delivery.

# Optional: Razorpay key (public key only — never put secret here)
# NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxx

# Mapbox GL JS Access Token (Leave blank to use built-in OpenStreetMap fallback tiles)
NEXT_PUBLIC_MAPBOX_TOKEN=
