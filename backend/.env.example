# Vegito API - Environment Configuration Template

# Application
APP_NAME=Vegito API
ENVIRONMENT=development
DEBUG=true
API_V1_STR=/api/v1
SERVICE_CITY=Solapur

# Database (PostgreSQL 18 on port 5433)
DATABASE_URL=postgresql+psycopg://postgres:Vegito%402026@localhost:5433/vegito_db

# Security & JWT
JWT_SECRET_KEY=super-secret-vegito-jwt-key-change-in-production-min-32-chars-long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# OTP Configuration
OTP_EXPIRE_MINUTES=5
OTP_DEV_MODE=false
OTP_DEV_CODE=123456
OTP_MAX_ATTEMPTS=5

# Twilio Verify (leave empty to use the local development fallback)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# CORS (comma separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000

# Payment Provider (mock or razorpay)
PAYMENT_PROVIDER=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Future-ready integrations (optional in development)
REDIS_URL=
MAP_PROVIDER=mock
MAP_API_KEY=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
